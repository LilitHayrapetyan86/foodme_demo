# --- AI agents (machine-local settings) -----------------------------------
.claude/settings.local.json
# .claude/skills and .claude/agents are committed as symlinks to ../.agents/*.
# On Windows without symlink support they are local junctions instead; the
# trailing slash keeps git from adding their contents a second time.
.claude/skills/
.claude/agents/

# --- Regression reports (local, see /run-regression) ---------------------
reports/
